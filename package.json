    "uuid": "^8.3.2",
    "xlsx": "^0.18.5",
    "xlsx-template": "^1.3.0"
  },
  "engines": {
    "node": "^18.18"
  },
  "scripts": {
    "setup": "npm install && npm run setup:ui",
    "setup:ui": "cd app && npm install",
    "deploy": "cds deploy db --to sqlite:db/sxtender.db",
    "deploy:hana": "cds deploy --to hana --vcap-file ./default-env.json",
    "deploy:hana:as": "cds deploy --to hana:FAST-db-hdi-container-as --auto-undeploy",
    "build": "cds build/all --clean",
    "build:prd": "cds -v && cds build --production",
    "build:local": "rm -rf ./srv/node_modules && cds build/all --clean ",
    "build:xs-security": "cds compile srv/ --to xsuaa  > xs-security.json",
    "build:xsa": "mbt build -p=xsa --mtar=FASTCAP-Backend.mtar",
    "build:cf": "mbt build -p=cf --mtar=FASTCAP-Backend-CF.mtar",
    "build:trial": "cp mta-trial.yaml mta.yaml && npm run build:cf && cp mta-original.yaml mta.yaml",
    "deploy:cf": "cf deploy mta_archives/FASTCAP-Backend-CF.mtar",
    "debug": "node --inspect node_modules/@sap/cds/bin/cds.js run",
    "start:cds": "cds run",
    "start": "cds -v && node ./srv/index-local.js"
  },
  "private": true,
  "cds": {
    "hana": {
      "deploy-format": "hdbtable"
    },
    "features": {
      "assert_integrity": false
    },
    "requires": {
      "db": {
        "kind": "hana",
        "pool": {
          "max": 2000,
          "min": 100,
          "acquireTimeoutMillis": 10000
        }
      },
      "uaa": {
        "kind": "xsuaa"
      },
      "UITemplates": {
        "kind": "odata",
        "model": "srv/external/UITemplates",
        "credentials": {
          "destination": "fast-templates-api",
          "path": "/UITemplates"
        }
      },
      "ConditionContract": {
        "kind": "odata",
        "model": "srv/external/ConditionContract",
        "csrf": true,
        "csrfInBatch": true,
        "credentials": {
          "destination": "fast-ccma-api",
          "path": "/odata/v4/condition-contract"
        }
      }
    },
    "odata": {
      "version": "v4"
    },
    "query": {
      "limit": {
        "default": 5000,
        "max": 5000
      }
    }
  },
  "files": [
    "db",
    "srv"
  ],
  "devDependencies": {
    "@sap/hdi-deploy": "4.8.2"
  }
}